{
  "product": "decision_desk_street_view_3d",
  "schema_version": "1.3.0",
  "engine": "maplibre_gl",
  "inspired_by_pattern": "street-level 3D hotspot drill-down from 2D map (research UI pattern)",
  "flood_model": {
    "kind": "hand_lead_x_road_buffer_minus_buildings",
    "description": "At each hotspot (expanded shortlist + FloodNet), buffer nearby LION wet-edge (or synthetic) road segments into curb/lane/center bands, subtract building footprints, and extrude by Decision Desk HAND lead cm. Citywide 2D companion: street_flood_citywide.geojson. Not a 2D SWE free surface.",
    "inputs": [
      "corridor_wet_edges.geojson (LION \u00d7 HAND)",
      "building_footprints_sample.geojson (or synthetic blocks)",
      "decision_desk HAND depth_series_cm by lead",
      "street_flood_citywide.geojson (2D citywide)"
    ],
    "honesty": "Research curb/street screening geometry \u2014 NOT photogrammetry, NOT hydraulic routing, NOT NWS."
  },
  "digital_twin": {
    "kind": "maplibre_extrusion_plus_openfreemap",
    "nvidia_model": null,
    "note": "Best achievable this pass: MapLibre fill-extrusion buildings with vertical gradient + OpenFreeMap liberty streets. No NVIDIA Omniverse / kaolin digital twin installed \u2014 upgrade path documented in command-center-ux.md."
  },
  "honesty": "Research HAND/MRMS lead-frame screening in MapLibre 3D curb/street buffers. NOT photogrammetry street-truth. NOT official guidance. HAND cm \u2260 FloodNet sensor metres. SFINCS remains optional Advanced / non-peer.",
