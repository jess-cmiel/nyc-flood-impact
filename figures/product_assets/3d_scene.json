    "terrain_exaggeration": 1.0,
    "light": {
      "anchor": "viewport",
      "color": "#f2f0ea",
      "intensity": 0.42,
      "position": [
        1.15,
        210,
        35
      ]
    },
    "note": "OpenFreeMap liberty streets + product GeoJSON building/depth extrusions. demotiles is a countries demo (not streets) and its terrain 404s over NYC. No sky layer (MapLibre 3.6.2); atmosphere via light + fog-tint overlays."
